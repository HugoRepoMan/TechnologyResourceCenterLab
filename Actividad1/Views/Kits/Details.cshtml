@model Actividad1.Models.Kit

@{
    ViewData["Title"] = "Detalle del Kit";
    string statusColor = Model.GetState() == "AVAILABLE" ? "bg-success" : (Model.GetState() == "NEEDS REPAIR" || Model.GetState() == "OUT OF STOCK" ? "bg-danger" : "bg-warning text-dark");
}

<div class="container mt-5">
    <h1 class="stamped-heading text-center">D E T A I L S</h1>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="content-card dope-card p-5" style="border-color: var(--color-almost-white);">
                <div class="d-flex justify-content-between align-items-center">
                    <h2><i class="bi bi-box-seam me-2" style="color: var(--color-signal-violet);"></i>@Model.Name <span class="badge bg-secondary ms-2" style="font-size: 14px;">@Model.GetKitComplexity()</span></h2>
                    <span class="badge bg-dark border border-secondary">ID #@Model.Id</span>
                </div>
                <hr style="border-color: rgba(247,249,250,0.2);" />

                <div class="row mb-4">
                    <div class="col-sm-6">
                        <p><strong>Categoría:</strong> @Model.Category</p>
                        <p><strong>Cantidad de Kits:</strong> @Model.Quantity unidades</p>
                        <p><strong>Estado:</strong> <span class="badge @statusColor">@Model.GetState()</span></p>
                    </div>
                    <div class="col-sm-6">
                        <p><strong>Tarifa Diaria:</strong> $@Model.DailyRate.ToString("F2")</p>
                        <p><strong>Operativo:</strong> @(Model.IsOperational ? "Totalmente Funcional" : "Requiere Mantenimiento")</p>
                    </div>
                </div>
                <div class="p-3 mb-4 rounded" style="background-color: rgba(247,249,250,0.05);">
                    <h5 style="color: var(--color-almost-white);"><i class="bi bi-calculator me-2"></i>Costo Estimado de Alquiler</h5>
                    <ul class="list-unstyled mb-0" style="color: var(--color-steel);">
                        <li>1 día: <strong>$@Model.CalculateEstimatedCost(1).ToString("F2")</strong></li>
                        <li>7 días (1 Semana): <strong>$@Model.CalculateEstimatedCost(7).ToString("F2")</strong></li>
                        <li>14 días (2 Semanas): <strong>$@Model.CalculateEstimatedCost(14).ToString("F2")</strong></li>
                    </ul>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-dope-outline">
                        <i class="bi bi-arrow-left me-1"></i> Volver a Kits
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dope-violet">
                        <i class="bi bi-pencil-square me-1"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash3 me-1"></i> Eliminar
                    </a>
                    <a asp-action="ByLevel" class="btn btn-dope-outline ms-auto" style="border-color: var(--color-signal-violet); color: var(--color-signal-violet);">
                        <i class="bi bi-bar-chart-steps me-1"></i> Ver por Nivel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
