@model IEnumerable<Actividad1.Models.Accessory>

@{
    ViewData["Title"] = "Accesorios por Categoría";
    var accessoriesByCategory = Model.GroupBy(a => a.Category);
}

<div class="container mt-5">
    <h1 class="stamped-heading text-center" style="color: var(--color-signal-violet);">B Y   C A T E G O R Y</h1>

    @foreach (var group in accessoriesByCategory)
    {
        <h3 class="mt-5 mb-3" style="font-family: 'JetBrains Mono', monospace; font-weight: 400; border-bottom: 1px solid rgba(247,249,250,0.1); padding-bottom: 10px;">
            <span style="color: var(--color-signal-violet);">//</span> @group.Key
        </h3>

        <div class="row g-4 mb-5">
            @foreach (var accessory in group)
            {
                <div class="col-md-3">
                    <div class="content-card dope-card h-100 d-flex flex-column">
                        <h6 class="mb-1">@accessory.Name</h6>
                        <p class="mb-3" style="color: var(--color-steel); font-size: 12px;">@accessory.Brand</p>

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 14px;">$@accessory.Price.ToString("F2")</span>
                            <a asp-action="Details" asp-route-id="@accessory.Id" class="btn btn-sm btn-dope-outline" style="padding: 2px 10px; font-size: 12px;">
                                <i class="bi bi-eye me-1"></i> Ver
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-dope-outline">
            <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo de Accesorios
        </a>
    </div>
</div>
